# Copy this file to .env for local use. Never commit a real key.
MODEL_API_KEY=
MODEL_ENDPOINT=https://your-provider.example/v1/chat/completions
MODEL_NAME=your-model-name
# Default 0 preserves one paid attempt. Enable only after reviewing cost/idempotency risk.
MODEL_MAX_RETRIES=0
MODEL_RETRY_BACKOFF_SECONDS=0.5
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATE_K=20
